<Window
    x:Class="PrivateCloudDisk.Downloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PrivateCloudDisk 安装程序"
    Width="600" Height="700"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 品牌色 -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#1A73E8"/>
        <SolidColorBrush x:Key="BrandSecondary" Color="#7B2FBE"/>
        <SolidColorBrush x:Key="BrandDark" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="BrandLight" Color="#E8F0FE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F8FAFC"/>

        <!-- 渐变 -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A73E8" Offset="0"/>
            <GradientStop Color="#7B2FBE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A2E" Offset="0"/>
            <GradientStop Color="#16213E" Offset="1"/>
        </LinearGradientBrush>

        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 顶部 Header ====== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="32,28">
            <StackPanel>
                <!-- Logo 和品牌名 -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource BrandGradient}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF0AE;"
                                  FontSize="24" Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="PrivateCloudDisk" FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="企业级私有云存储" FontSize="12"
                                   Foreground="#A0A0B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="正在为您安装 PrivateCloudDisk 桌面客户端"
                           FontSize="13" Foreground="#808090"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- ====== 中间内容区域 ====== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24">
                <!-- 安装步骤指示器 -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="12"
                        Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="安装进度" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <!-- 步骤条 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 步骤 1: 连接 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding IsStep1, Converter={StaticResource StepBackgroundConverter}}">
                                    <FontIcon Glyph="&#xE70D;" FontSize="14"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="连接" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- 步骤 2: 下载 -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding IsStep2, Converter={StaticResource StepBackgroundConverter}}">
                                    <FontIcon Glyph="&#xE90F;" FontSize="14"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="下载" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- 步骤 3: 验证 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding IsStep3, Converter={StaticResource StepBackgroundConverter}}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="验证" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- 步骤 4: 安装 -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding IsStep4, Converter={StaticResource StepBackgroundConverter}}">
                                    <FontIcon Glyph="&#xE7F1;" FontSize="14"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="安装" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- 步骤 5: 完成 -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{Binding IsStep5, Converter={StaticResource StepBackgroundConverter}}">
                                    <FontIcon Glyph="&#xE8FB;" FontSize="14"
                                              Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="完成" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 下载进度卡片 -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="12"
                        Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 进度条 -->
                        <Grid Margin="0,16,0,0">
                            <ProgressBar Height="6" Value="{Binding ProgressPercent}"
                                         Maximum="100" Foreground="{StaticResource BrandPrimary}"
                                         Background="#E5E7EB"/>
                        </Grid>

                        <!-- 下载详情 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="速度" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SpeedDisplay}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="剩余时间" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding ETADisplay}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="文件大小" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SizeDisplay}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 下载进度数值 -->
                        <TextBlock Margin="0,8,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}">
                            <Run Text="{Binding DownloadedDisplay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding SizeDisplay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 版本信息 -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="12"
                        Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="版本信息" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本号" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}"
                                       FontWeight="SemiBold" FontSize="13"/>

                            <TextBlock Grid.Row="1" Margin="0,8,0,0"
                                       Text="文件大小" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                       Text="{Binding AppSize}" FontWeight="SemiBold" FontSize="13"/>
                        </Grid>

                        <TextBlock Text="更新内容" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,16,0,8"/>
                        <TextBlock Text="{Binding ReleaseNotes}" FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- 错误提示 -->
                <Border Background="#FEF2F2" CornerRadius="12" Padding="16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="{StaticResource DangerRed}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerRed}"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ====== 底部操作栏 ====== -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" Padding="32,16"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧: 协议链接 -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                        <Underline>用户协议</Underline>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                        <Underline>隐私政策</Underline>
                    </TextBlock>
                </StackPanel>

                <!-- 右侧: 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource OutlineButton}"
                            Content="最小化"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource OutlineButton}"
                            Content="取消"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="开始下载"
                            Command="{Binding StartDownloadCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="立即安装"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="启动应用"
                            Command="{Binding LaunchCommand}"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>