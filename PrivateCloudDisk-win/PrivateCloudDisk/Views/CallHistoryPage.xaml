<!-- ============================================================
  CallHistoryPage.xaml — 通话记录页面
  展示用户历史通话记录，支持按类型过滤、分页、删除。
============================================================ -->
<Page
    x:Class="PrivateCloudDisk.Views.CallHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CallTypeIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <Grid Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="通话记录" FontSize="20" FontWeight="SemiBold" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="FilterAll" Content="全部" Style="{StaticResource DefaultButtonStyle}" />
                <Button x:Name="FilterVideo" Content="视频" Style="{StaticResource DefaultButtonStyle}" />
                <Button x:Name="FilterVoice" Content="语音" Style="{StaticResource DefaultButtonStyle}" />
                <Button x:Name="FilterMissed" Content="未接" Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 通话记录列表 -->
        <ListView Grid.Row="1" x:Name="CallRecordList"
                  ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnSpacing="12"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 通话类型图标 -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE714;" FontSize="16"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- 通话信息 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding CallerName}" FontWeight="SemiBold"
                                           FontSize="14" />
                                <FontIcon Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding CalleeName}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="视频通话" />
                                </TextBlock>
                                <TextBlock Text="·" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding Status}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="·" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding Duration}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 通话时间 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CreateTime}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button Width="28" Height="28" CornerRadius="14"
                                    Background="Transparent"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Margin="0,4,0,0" HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE712;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <!-- 空状态 -->
            <ListView.EmptyContent>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="32">
                    <FontIcon Glyph="&#xE717;" FontSize="48"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="暂无通话记录" FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="在消息中心发起视频或语音通话"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </ListView.EmptyContent>
        </ListView>

        <!-- 分页 -->
        <Grid Grid.Row="2" Padding="16,8" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PrevPage" Content="上一页"
                        Style="{StaticResource DefaultButtonStyle}" />
                <TextBlock x:Name="PageInfo" Text="第 1/1 页"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="NextPage" Content="下一页"
                        Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>