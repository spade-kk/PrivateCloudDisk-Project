<!-- ============================================================
  CallPage.xaml — 视频/语音通话页面
  企业级视频通话界面，包含：
  - 远端视频全屏背景
  - 本地视频画中画
  - 通话控制栏（静音、摄像头、屏幕共享、挂断）
  - 网络质量指示器
  - 编码参数状态显示
  - 通话时长计时器
============================================================ -->
<Page
    x:Class="PrivateCloudDisk.Views.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1A1A2E">

    <Page.Resources>
        <Style x:Key="CallControlButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <Style x:Key="HangupButton" TargetType="Button" BasedOn="{StaticResource CallControlButton}">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="32" />
        </Style>

        <Style x:Key="ActiveCallButton" TargetType="Button" BasedOn="{StaticResource CallControlButton}">
            <Setter Property="Background" Value="#44FFFFFF" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- 来电提示（无通话时显示） -->
        <Grid x:Name="IncomingCallPanel"
              Visibility="{x:Bind ViewModel.HasIncomingCall, Mode=OneWay}"
              Background="#80000000"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="16" MaxWidth="360">
                <!-- 头像 -->
                <PersonPicture
                    Width="96" Height="96"
                    DisplayName="{x:Bind ViewModel.IncomingCall.CallerName, Mode=OneWay}"
                    HorizontalAlignment="Center" />

                <!-- 来电信息 -->
                <TextBlock Text="{x:Bind ViewModel.IncomingCall.CallerName, Mode=OneWay}"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />

                <TextBlock FontSize="16" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center">
                    <Run Text="邀请你进行" />
                    <Run Text="{x:Bind ViewModel.IncomingCall.CallType}" />
                </TextBlock>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="32" Margin="0,16,0,0">
                    <Button Width="64" Height="64" CornerRadius="32"
                            Background="#E81123" Foreground="White"
                            Command="{x:Bind ViewModel.RejectCallCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="24" />
                    </Button>
                    <Button Width="64" Height="64" CornerRadius="32"
                            Background="#10893E" Foreground="White"
                            Command="{x:Bind ViewModel.AcceptCallCommand}">
                        <FontIcon Glyph="&#xE717;" FontSize="24" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 通话中界面 -->
        <Grid x:Name="CallActivePanel"
              Visibility="{x:Bind ViewModel.IsInCall, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部信息栏 -->
            <Grid Grid.Row="0" Padding="16,12" Background="#22000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 远端用户名 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <PersonPicture Width="32" Height="32"
                                   DisplayName="{x:Bind ViewModel.RemoteName, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.RemoteName, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <!-- 通话时长 -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CallDurationText, Mode=OneWay}"
                           FontSize="14" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- 网络质量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{x:Bind ViewModel.NetworkQuality, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.NetworkQualityLabel, Mode=OneWay}"
                               FontSize="12" Foreground="#CCFFFFFF"
                               Margin="6,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 视频区域 -->
            <Grid Grid.Row="1">
                <!-- 远端视频（全屏背景） -->
                <Border Background="#0D0D1A" />
                <TextBlock Text="远端视频"
                           Foreground="#44FFFFFF" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- 本地视频画中画 -->
                <Border x:Name="LocalVideoPip"
                        Width="180" Height="120"
                        CornerRadius="8"
                        Background="#333355"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="16">
                    <TextBlock Text="本地视频"
                               Foreground="#88FFFFFF" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- 编码参数状态 -->
                <Border x:Name="EncoderInfo"
                        Background="#44000000" CornerRadius="4"
                        Padding="8,4" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.EncoderParams.Description, Mode=OneWay}"
                                   FontSize="11" Foreground="#AAFFFFFF" />
                        <TextBlock Text="{x:Bind ViewModel.EncoderParams.Quality, Mode=OneWay}"
                                   FontSize="11" Foreground="#88FFFFFF" />
                    </StackPanel>
                </Border>

                <!-- 屏幕共享提示 -->
                <Border x:Name="ScreenShareBanner"
                        Visibility="{x:Bind ViewModel.IsScreenSharing, Mode=OneWay}"
                        Background="#44007ACC" CornerRadius="4"
                        Padding="12,6" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" Foreground="White" />
                        <TextBlock Text="正在共享屏幕" FontSize="13"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部控制栏 -->
            <Grid Grid.Row="2" Padding="16,12" Background="#22000000">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="12">
                    <!-- 静音 -->
                    <Button Style="{StaticResource ActiveCallButton}"
                            Command="{x:Bind ViewModel.ToggleMuteCommand}"
                            Visibility="{x:Bind ViewModel.IsMuted, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74F;" />
                    </Button>
                    <Button Style="{StaticResource CallControlButton}"
                            Command="{x:Bind ViewModel.ToggleMuteCommand}"
                            Visibility="{x:Bind ViewModel.IsMuted, Mode=OneWay}">
                        <FontIcon Glyph="&#xE720;" />
                    </Button>

                    <!-- 摄像头 -->
                    <Button Style="{StaticResource ActiveCallButton}"
                            Command="{x:Bind ViewModel.ToggleCameraCommand}"
                            Visibility="{x:Bind ViewModel.IsCameraOff, Mode=OneWay}">
                        <FontIcon Glyph="&#xE890;" />
                    </Button>
                    <Button Style="{StaticResource CallControlButton}"
                            Command="{x:Bind ViewModel.ToggleCameraCommand}"
                            Visibility="{x:Bind ViewModel.IsCameraOff, Mode=OneWay}">
                        <FontIcon Glyph="&#xE714;" />
                    </Button>

                    <!-- 屏幕共享 -->
                    <Button Style="{StaticResource ActiveCallButton}"
                            Command="{x:Bind ViewModel.ToggleScreenShareCommand}"
                            Visibility="{x:Bind ViewModel.IsScreenSharing, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8F4;" />
                    </Button>
                    <Button Style="{StaticResource CallControlButton}"
                            Command="{x:Bind ViewModel.ToggleScreenShareCommand}"
                            Visibility="{x:Bind ViewModel.IsScreenSharing, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8F4;" />
                    </Button>

                    <!-- 挂断 -->
                    <Button Style="{StaticResource HangupButton}"
                            Command="{x:Bind ViewModel.HangupCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="22" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 空闲状态 -->
        <Grid x:Name="IdlePanel"
              Visibility="{x:Bind ViewModel.IsInCall, Mode=OneWay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE717;" FontSize="48" Foreground="#44FFFFFF" />
                <TextBlock Text="暂无通话"
                           FontSize="18" Foreground="#66FFFFFF"
                           HorizontalAlignment="Center" />
                <TextBlock Text="在消息中心发起视频或语音通话"
                           FontSize="13" Foreground="#44FFFFFF"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>