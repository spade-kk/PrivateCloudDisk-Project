<Page
    x:Class="PrivateCloudDisk.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <!-- 登录/注册卡片 -->
        <Border Style="{StaticResource CardBorder}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="400" MaxWidth="440" Padding="40">
            <StackPanel>
                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF0AE;"
                              FontSize="48" Foreground="{StaticResource PrimaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="PrivateCloudDisk" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="企业私有云盘" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 错误提示 -->
                <InfoBar x:Name="ErrorBar" Visibility="Collapsed" Severity="Error"
                         IsClosable="True" Margin="0,0,0,12"/>

                <!-- 登录表单 -->
                <StackPanel Visibility="{x:Bind ViewModel.IsRegisterMode, Converter={StaticResource InverseBoolConverter}}">
                    <TextBox x:Name="AccountBox" PlaceholderText="账号"
                             Text="{x:Bind ViewModel.Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <TextBox x:Name="PhoneBox" PlaceholderText="手机号 (可选)"
                             Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <PasswordBox x:Name="PasswordBox" PlaceholderText="密码"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,24"/>

                    <Button x:Name="LoginBtn" Style="{StaticResource PrimaryButton}"
                            Command="{x:Bind ViewModel.LoginCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoading}"
                                          Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Margin="0,0,8,0"/>
                            <TextBlock Text="登 录" />
                        </StackPanel>
                    </Button>

                    <HyperlinkButton Content="还没有账号？立即注册" Margin="0,8,0,0"
                                     Command="{x:Bind ViewModel.SwitchModeCommand}"
                                     HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 注册表单 -->
                <StackPanel Visibility="{x:Bind ViewModel.IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox x:Name="RegAccountBox" PlaceholderText="账号"
                             Text="{x:Bind ViewModel.RegisterAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <TextBox x:Name="RegNameBox" PlaceholderText="用户名"
                             Text="{x:Bind ViewModel.RegisterUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <PasswordBox x:Name="RegPasswordBox" PlaceholderText="密码"
                                 PasswordChanged="RegPasswordBox_PasswordChanged"
                                 Margin="0,0,0,12"/>
                    <PasswordBox x:Name="RegConfirmPasswordBox" PlaceholderText="确认密码"
                                 PasswordChanged="RegConfirmPasswordBox_PasswordChanged"
                                 Margin="0,0,0,24"/>

                    <Button x:Name="RegisterBtn" Style="{StaticResource PrimaryButton}"
                            Command="{x:Bind ViewModel.RegisterCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoading}"
                                          Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Margin="0,0,8,0"/>
                            <TextBlock Text="注 册" />
                        </StackPanel>
                    </Button>

                    <HyperlinkButton Content="已有账号？返回登录" Margin="0,8,0,0"
                                     Command="{x:Bind ViewModel.SwitchModeCommand}"
                                     HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>