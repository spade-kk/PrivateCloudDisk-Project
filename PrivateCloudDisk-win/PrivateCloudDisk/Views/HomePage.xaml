<Page
    x:Class="PrivateCloudDisk.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrivateCloudDisk.Models"
    xmlns:converters="using:PrivateCloudDisk.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 面包屑导航 -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Breadcrumb, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:NodeItem">
                        <StackPanel Orientation="Horizontal">
                            <HyperlinkButton Content="{x:Bind EffectiveName}"
                                             Command="{x:Bind ViewModel.NavigateBreadcrumbCommand}"
                                             CommandParameter="{x:Bind}"
                                             Padding="4,0"/>
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;"
                                      FontSize="10" VerticalAlignment="Center"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 视图切换 & 搜索 -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8">
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索文件..."
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                Width="240"/>
                <Button Style="{StaticResource IconButton}" ToolTipService.ToolTip="切换视图"
                        Command="{x:Bind ViewModel.ToggleViewCommand}">
                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              Glyph="{x:Bind ViewModel.IsGridView ? '&#xE8D9;' : '&#xE8A5;'}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTipService.ToolTip="刷新"
                        Command="{x:Bind ViewModel.RefreshCommand}">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 分割线 -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}"/>

        <!-- 文件列表 -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                  Style="{StaticResource FileListView}"
                  DoubleTapped="FileList_DoubleTapped"
                  RightTapped="FileList_RightTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NodeItem">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <!-- 文件图标 -->
                        <FontIcon Grid.Column="0"
                                  Glyph="{x:Bind IsDirectory ? '&#xE1C5;' : '&#xE8A5;'}"
                                  FontSize="20" VerticalAlignment="Center"
                                  Foreground="{x:Bind IsDirectory ? StaticResource.PrimaryBrush : StaticResource.TextSecondaryBrush}"/>

                        <!-- 文件名 -->
                        <TextBlock Grid.Column="1" Text="{x:Bind EffectiveName}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 文件大小 -->
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind EffectiveSize, Converter={StaticResource FileSizeConverter}}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{x:Bind IsDirectory, Converter={StaticResource InverseBoolConverter}}"/>

                        <!-- 修改时间 -->
                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind EffectiveTime, Converter={StaticResource DateTimeFormatConverter}}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Visibility="{x:Bind IsDirectory, Converter={StaticResource InverseBoolConverter}}"
                                    Click="DownloadButton_Click" Tag="{x:Bind}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE90F;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Click="RenameButton_Click" Tag="{x:Bind}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                    Click="DeleteButton_Click" Tag="{x:Bind}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14"
                                          Foreground="{StaticResource DangerBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 加载中 -->
        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40" VerticalAlignment="Center"
                      HorizontalAlignment="Center"/>

        <!-- 空状态 -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.Items.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="48"
                      Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="此目录为空" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 重命名弹窗                                              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ContentDialog x:Name="RenameDialog"
                       Title="重命名"
                       PrimaryButtonText="确认"
                       SecondaryButtonText="取消"
                       PrimaryButtonCommand="{x:Bind ViewModel.ConfirmRenameCommand}"
                       SecondaryButtonCommand="{x:Bind ViewModel.CancelRenameCommand}"
                       IsPrimaryButtonEnabled="True"
                       DefaultButton="Primary">
            <TextBox Text="{x:Bind ViewModel.RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="输入新名称"
                     Width="320"/>
        </ContentDialog>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 新建文件夹弹窗                                            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ContentDialog x:Name="CreateFolderDialog"
                       Title="新建文件夹"
                       PrimaryButtonText="创建"
                       SecondaryButtonText="取消"
                       PrimaryButtonCommand="{x:Bind ViewModel.CreateFolderCommand}"
                       SecondaryButtonCommand="{x:Bind ViewModel.CancelRenameCommand}"
                       DefaultButton="Primary">
            <TextBox Text="{x:Bind ViewModel.CreateFolderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="文件夹名称"
                     Width="320"/>
        </ContentDialog>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 上传弹窗                                                -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ContentDialog x:Name="UploadDialog"
                       Title="上传文件"
                       PrimaryButtonText="选择文件"
                       SecondaryButtonText="关闭"
                       PrimaryButtonCommand="{x:Bind ViewModel.SelectFilesCommand}"
                       SecondaryButtonCommand="{x:Bind ViewModel.CloseUploadDialogCommand}"
                       IsPrimaryButtonEnabled="{x:Bind ViewModel.UploadTotalFiles > 0, Converter={StaticResource InverseBoolConverter}}"
                       DefaultButton="Primary">
            <StackPanel Width="400">
                <ProgressBar Value="{x:Bind ViewModel.UploadProgress, Mode=OneWay}"
                             Foreground="{StaticResource PrimaryBrush}"
                             Visibility="{x:Bind ViewModel.UploadTotalFiles > 0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{x:Bind ViewModel.UploadStatus, Mode=OneWay}"
                           Margin="0,8,0,0"
                           Visibility="{x:Bind ViewModel.UploadTotalFiles > 0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{x:Bind (ViewModel.UploadCompletedFiles)}/{x:Bind (ViewModel.UploadTotalFiles)} 个文件已完成"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.UploadTotalFiles > 0, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="将文件拖入窗口或点击「选择文件」上传"
                           Visibility="{x:Bind ViewModel.UploadTotalFiles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>