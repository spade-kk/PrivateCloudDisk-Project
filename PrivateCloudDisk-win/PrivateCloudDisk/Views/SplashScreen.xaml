<Page
    x:Class="PrivateCloudDisk.Views.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    mc:Ignorable="d"
    Background="#1A1A2E">

    <Page.Resources>
        <Storyboard x:Name="LogoAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0" Duration="0:0:2"
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1.0" To="1.05" Duration="0:0:2"
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1.0" To="1.05" Duration="0:0:2"
                             AutoReverse="True"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.Resources>
            <media:LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1A2E" Offset="0.0"/>
                <GradientStop Color="#16213E" Offset="0.5"/>
                <GradientStop Color="#0F3460" Offset="1.0"/>
            </media:LinearGradientBrush>
            <media:LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1A73E8" Offset="0.0"/>
                <GradientStop Color="#4A90D9" Offset="0.5"/>
                <GradientStop Color="#7B2FBE" Offset="1.0"/>
            </media:LinearGradientBrush>
        </Grid.Resources>

        <Grid.Background>
            <StaticResource ResourceKey="BackgroundGradient"/>
        </Grid.Background>

        <!-- 装饰性背景粒子 -->
        <Canvas x:Name="ParticlesCanvas" Opacity="0.3"/>

        <!-- 主内容 -->
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="24" MaxWidth="480">
                <!-- Logo 中心 -->
                <Grid x:Name="LogoScale" HorizontalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <!-- 发光效果 -->
                    <Border x:Name="LogoGlow" Width="140" Height="140"
                            CornerRadius="70" HorizontalAlignment="Center"
                            Opacity="0.5">
                        <Border.Background>
                            <media:RadialGradientBrush>
                                <GradientStop Color="#1A73E8" Offset="0.0"/>
                                <GradientStop Color="Transparent" Offset="1.0"/>
                            </media:RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Logo 图标 -->
                    <Border Width="120" Height="120" CornerRadius="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Background>
                            <media:LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A73E8" Offset="0.0"/>
                                <GradientStop Color="#7B2FBE" Offset="1.0"/>
                            </media:LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF0AE;"
                                      FontSize="48" Foreground="White"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="PCD" FontSize="16" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 品牌名称 -->
                <TextBlock x:Name="BrandName"
                           Text="PrivateCloudDisk"
                           FontSize="32" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           HorizontalTextAlignment="Center"
                           Opacity="0">
                    <TextBlock.Resources>
                        <Storyboard x:Name="BrandFadeIn">
                            <DoubleAnimation Storyboard.TargetName="BrandName"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.8"
                                             BeginTime="0:0:0.3"/>
                            <DoubleAnimation Storyboard.TargetName="BrandName"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="20" To="0" Duration="0:0:0.8"
                                             BeginTime="0:0:0.3"/>
                        </Storyboard>
                    </TextBlock.Resources>
                    <TextBlock.RenderTransform>
                        <TranslateTransform/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- 副标题 -->
                <TextBlock x:Name="Subtitle"
                           Text="企业级私有云存储解决方案"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#A0A0B8"
                           HorizontalAlignment="Center"
                           HorizontalTextAlignment="Center"
                           Opacity="0">
                    <TextBlock.Resources>
                        <Storyboard x:Name="SubtitleFadeIn">
                            <DoubleAnimation Storyboard.TargetName="Subtitle"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.8"
                                             BeginTime="0:0:0.6"/>
                        </Storyboard>
                    </TextBlock.Resources>
                </TextBlock>

                <!-- 分隔线 -->
                <Border x:Name="Divider"
                        Width="60" Height="2" HorizontalAlignment="Center"
                        Opacity="0">
                    <Border.Background>
                        <StaticResource ResourceKey="BrandGradient"/>
                    </Border.Background>
                    <Border.Resources>
                        <Storyboard x:Name="DividerFadeIn">
                            <DoubleAnimation Storyboard.TargetName="Divider"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.6"
                                             BeginTime="0:0:0.9"/>
                        </Storyboard>
                    </Border.Resources>
                </Border>

                <!-- 特性描述 -->
                <StackPanel x:Name="Features"
                            HorizontalAlignment="Center" Spacing="8"
                            Opacity="0">
                    <StackPanel.Resources>
                        <Storyboard x:Name="FeaturesFadeIn">
                            <DoubleAnimation Storyboard.TargetName="Features"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.8"
                                             BeginTime="0:0:1.2"/>
                        </Storyboard>
                    </StackPanel.Resources>
                    <TextBlock Text="云端存储，本地访问" FontSize="14"
                               Foreground="#808090" HorizontalAlignment="Center"/>
                    <TextBlock Text="企业级安全加密  |  多端协同  |  高效同步"
                               FontSize="12" Foreground="#606070"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 加载进度 -->
                <StackPanel x:Name="LoadingSection"
                            HorizontalAlignment="Center" Spacing="12"
                            Opacity="0">
                    <StackPanel.Resources>
                        <Storyboard x:Name="LoadingFadeIn">
                            <DoubleAnimation Storyboard.TargetName="LoadingSection"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.8"
                                             BeginTime="0:0:1.5"/>
                        </Storyboard>
                    </StackPanel.Resources>

                    <ProgressBar x:Name="LoadingProgress"
                                 Width="300" Height="4"
                                 Value="{x:Bind ViewModel.LoadingProgress, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                 Foreground="#1A73E8"
                                 Background="#2A2A4E"/>

                    <TextBlock x:Name="StatusText"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="13" Foreground="#808090"
                               HorizontalAlignment="Center"
                               HorizontalTextAlignment="Center"/>
                </StackPanel>

                <!-- 版本号 -->
                <TextBlock x:Name="VersionText"
                           Text="v1.0.0"
                           FontSize="12" Foreground="#505060"
                           HorizontalAlignment="Center"
                           Opacity="0">
                    <TextBlock.Resources>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="VersionText"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="0.6" Duration="0:0:1"
                                             BeginTime="0:0:2.0"/>
                        </Storyboard>
                    </TextBlock.Resources>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 底部版权 -->
        <TextBlock Text="© 2024 PrivateCloudDisk. All rights reserved."
                   FontSize="11" Foreground="#404050"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,24" Opacity="0.5"/>
    </Grid>
</Page>