<Page
    x:Class="PrivateCloudDisk.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Style="{StaticResource PageContainer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageHeaderText}" Text="设置"/>

        <StackPanel Grid.Row="1" MaxWidth="500" Margin="0,16,0,0" Spacing="16">
            <!-- 通用设置 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubHeaderText}" Text="通用"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自启动" FontWeight="SemiBold"/>
                            <TextBlock Text="系统启动时自动运行 PrivateCloudDisk"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="最小化到系统托盘" FontWeight="SemiBold"/>
                            <TextBlock Text="关闭窗口时最小化到系统托盘而不是退出"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 下载设置 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubHeaderText}" Text="下载"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="下载路径" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.DownloadPath, Mode=OneWay}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}"
                                Command="{x:Bind ViewModel.BrowseDownloadPathCommand}">
                            浏览
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 服务器设置 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SubHeaderText}" Text="服务器"/>

                    <TextBox PlaceholderText="服务器地址"
                             Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{x:Bind ViewModel.SaveCommand}">
                    保存设置
                </Button>
                <Button Style="{StaticResource DangerButton}"
                        Command="{x:Bind ViewModel.ResetCommand}">
                    恢复默认
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>