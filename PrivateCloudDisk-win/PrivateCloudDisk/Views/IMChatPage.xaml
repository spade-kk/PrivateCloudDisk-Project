<!-- ============================================================
  IMChatPage.xaml — IM 聊天页面
  企业IM桌面客户端消息中心，包含：
  - 左侧会话列表
  - 右侧消息区域
  - 底部输入栏
  - 通话按钮（语音/视频）
============================================================ -->
<Page
    x:Class="PrivateCloudDisk.Views.IMChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="MessageBubbleSent" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="CornerRadius" Value="12,12,4,12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MaxWidth" Value="400" />
        </Style>
        <Style x:Key="MessageBubbleReceived" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12,12,12,4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MaxWidth" Value="400" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧会话列表 -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 搜索栏 -->
            <Grid Grid.Row="0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBox PlaceholderText="搜索联系人..."
                         Style="{StaticResource DefaultTextBoxStyle}" />
            </Grid>

            <!-- 会话列表 -->
            <ListView Grid.Row="1" x:Name="ConversationList"
                      ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentConversation, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture Grid.Column="0" Width="40" Height="40"
                                           DisplayName="{Binding Name}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastMessage}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding LastMessageTime}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Border x:Name="UnreadBadge"
                                        Visibility="{Binding UnreadCount}"
                                        Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="10" MinWidth="20" Height="20"
                                        Padding="6,0" HorizontalAlignment="Right"
                                        Margin="0,4,0,0">
                                    <TextBlock Text="{Binding UnreadCount}" FontSize="11"
                                               Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 右侧消息区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 会话标题栏 -->
            <Grid Grid.Row="0" Padding="16,10"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <PersonPicture Width="36" Height="36"
                                   DisplayName="{x:Bind ViewModel.CurrentConversation.Name, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentConversation.Name, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- 通话按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="VoiceCallButton" Width="36" Height="36"
                            CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            ToolTipService.ToolTip="语音通话">
                        <FontIcon Glyph="&#xE717;" FontSize="16" />
                    </Button>
                    <Button x:Name="VideoCallButton" Width="36" Height="36"
                            CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            ToolTipService.ToolTip="视频通话">
                        <FontIcon Glyph="&#xE714;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 消息列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessageList"
                              ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                              Padding="16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <!-- 已发送消息（右对齐） -->
                                <Border x:Name="SentBubble"
                                        Style="{StaticResource MessageBubbleSent}"
                                        HorizontalAlignment="Right">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="White" FontSize="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SendTime}"
                                                   FontSize="10"
                                                   Foreground="#88FFFFFF"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 已接收消息（左对齐） -->
                                <Border x:Name="ReceivedBubble"
                                        Style="{StaticResource MessageBubbleReceived}"
                                        HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderName}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SendTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 输入栏 -->
            <Grid Grid.Row="2" Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="输入消息..."
                         AcceptsReturn="True"
                         MaxHeight="80"
                         Style="{StaticResource DefaultTextBoxStyle}" />

                <Button Grid.Column="1" x:Name="SendButton"
                        Margin="8,0,0,0" Width="80"
                        Command="{x:Bind ViewModel.SendMessageCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE725;" FontSize="14" />
                        <TextBlock Text="发送" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>