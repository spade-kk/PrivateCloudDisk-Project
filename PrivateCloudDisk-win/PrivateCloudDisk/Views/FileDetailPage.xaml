<Page
    x:Class="PrivateCloudDisk.Views.FileDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:PrivateCloudDisk.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Style="{StaticResource PageContainer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageHeaderText}" Text="文件详情"/>

            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <Border Style="{StaticResource CardBorder}" Padding="24">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="文件名" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileDetail.FileName}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="文件大小" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Margin="0,12,0,0"
                                       Text="{x:Bind ViewModel.FileSizeDisplay, Mode=OneWay}"/>

                            <TextBlock Text="文件类型" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Margin="0,12,0,0"
                                       Text="{x:Bind ViewModel.FileDetail.FileType}"/>

                            <TextBlock Text="上传时间" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Margin="0,12,0,0"
                                       Text="{x:Bind ViewModel.UploadTimeDisplay, Mode=OneWay}"/>

                            <TextBlock Text="SHA256" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Margin="0,12,0,0"
                                       Text="{x:Bind ViewModel.FileDetail.FileChecksum}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{x:Bind ViewModel.DownloadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE90F;" Margin="0,0,8,0"/>
                            <TextBlock Text="下载文件"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Command="{x:Bind ViewModel.ToggleStarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="{x:Bind ViewModel.IsStarred ? '&#xE710;' : '&#xE71A;'}"
                                      Foreground="{x:Bind ViewModel.IsStarred ? 'Gold' : ''}"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Bind ViewModel.IsStarred ? '取消收藏' : '添加收藏'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40" VerticalAlignment="Center"
                      HorizontalAlignment="Center"/>
    </Grid>
</Page>