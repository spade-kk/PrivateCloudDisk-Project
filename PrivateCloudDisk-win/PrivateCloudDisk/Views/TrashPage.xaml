<Page
    x:Class="PrivateCloudDisk.Views.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PrivateCloudDisk.Models"
    xmlns:converters="using:PrivateCloudDisk.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <Grid Style="{StaticResource PageContainer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource PageHeaderText}" Text="回收站"/>

            <Button Grid.Column="1" Style="{StaticResource DangerButton}"
                    Command="{x:Bind ViewModel.EmptyTrashCommand}"
                    Visibility="{x:Bind ViewModel.Items.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                清空回收站
            </Button>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  Style="{StaticResource FileListView}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TrashItem">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="{x:Bind IsFileItem ? '&#xE8A5;' : '&#xE1C5;'}"
                                  FontSize="20" VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="1" Text="{x:Bind TargetName}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind TargetSize, Converter={StaticResource FileSizeConverter}}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind DeletedTime, Converter={StaticResource DateTimeFormatConverter}}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                            <Button Style="{StaticResource OutlineButton}" Padding="8,4"
                                    Command="{x:Bind ViewModel.RestoreCommand}"
                                    CommandParameter="{x:Bind}">
                                <TextBlock Text="恢复" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Padding="8,4"
                                    Command="{x:Bind ViewModel.PermanentDeleteCommand}"
                                    CommandParameter="{x:Bind}">
                                <TextBlock Text="彻底删除" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.Items.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="48"
                      Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="回收站为空" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Page>