<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 颜色定义                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryColor">#1A73E8</Color>
    <Color x:Key="PrimaryDarkColor">#1557B0</Color>
    <Color x:Key="AccentColor">#34A853</Color>
    <Color x:Key="DangerColor">#EA4335</Color>
    <Color x:Key="WarningColor">#FBBC04</Color>
    <Color x:Key="SidebarBgColor">#F8F9FA</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="TextPrimaryColor">#202124</Color>
    <Color x:Key="TextSecondaryColor">#5F6368</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 通用样式                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="PageHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="SubHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="PlaceholderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 页面容器样式                                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="PageContainer" TargetType="Grid">
        <Setter Property="Padding" Value="32,24"/>
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
    </Style>

</ResourceDictionary>