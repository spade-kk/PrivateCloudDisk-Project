<mxfile>
  <diagram id="system-context" name="System Context">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="external_agent" value="External AI Agent&#xa;[Person]&#xa;Codex, Claude Code, Cursor or another MCP Client" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="0" y="30" width="200" height="180" as="geometry"/>
        </mxCell>
        <UserObject label="PrivateCloudDisk / CloudFlow&#xa;[Software System]&#xa;Authorized files, spaces, workflows and plugin capabilities" link="data:page/id,containers" id="cloudflow_platform">
          <mxCell style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#1061B0;strokeColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="260" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        </UserObject>
        <mxCell id="oauth_provider" value="OAuth 2.1 Authorization Server&#xa;[Software System]&#xa;Issues audience-bound user access tokens" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="570" y="60" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="OAuth 2.1 + PKCE" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="external_agent" target="oauth_provider">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="150"/><mxPoint x="560" y="150"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="MCP 2025-11-25 / HTTPS" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="external_agent" target="cloudflow_platform">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="70"/><mxPoint x="250" y="70"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Protected-resource metadata" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="cloudflow_platform" target="oauth_provider">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="90"/><mxPoint x="560" y="90"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="containers" name="Containers">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="agent_http" value="External MCP Client&#xa;[Container: Codex / Claude / Cursor]&#xa;Bearer-authenticated Streamable HTTP client" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="Gateway&#xa;[Container: Spring Cloud Gateway]&#xa;Bearer validation, route governance, HMAC trusted identity signing" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <UserObject label="CloudFlow MCP Server&#xa;[Container: Go / net/http]&#xa;JSON-RPC MCP adapter, tool filtering, sessions, rate limits, metrics" link="data:page/id,mcp-components" id="mcp_server">
          <mxCell style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="610" y="80" width="240" height="120" as="geometry"/>
        </mxCell>
        </UserObject>
        <mxCell id="capability_hub" value="Capability Hub&#xa;[Container: Workflow Service / Java]&#xa;Registry, schema, real-time permissions, dispatch, durable audit" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="business_plane" value="Platform Business Data Plane&#xa;[Container: Internal HTTP / RabbitMQ]&#xa;File, space, workflow and plugin data-plane implementations" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="1220" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="audit_db" value="Capability Audit&#xa;[Container: MySQL]&#xa;Capability and MCP protocol audit trail" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="1220" y="160" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="prometheus" value="Observability Stack&#xa;[Software System]&#xa;Prometheus scrape and trace correlation" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="POST /api/v1/mcp, Bearer token" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="agent_http" target="gateway">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="60"/><mxPoint x="290" y="60"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="private /mcp + pcd-mcp-v1 signed context" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="gateway" target="mcp_server">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="100"/><mxPoint x="600" y="100"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="internal MCP discovery/call/audit + service token" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_server" target="capability_hub">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="140"/><mxPoint x="900" y="140"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="reviewed capability dispatch + final resource authorization" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="capability_hub" target="business_plane">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="100"/><mxPoint x="1210" y="100"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="persist parameter summary and outcome" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="capability_hub" target="audit_db">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="180"/><mxPoint x="1210" y="180"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="GET /metrics" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="prometheus" target="mcp_server">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="180"/><mxPoint x="600" y="180"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mcp-components" name="MCP Components">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="mcp_transport" value="MCP Transport&#xa;[Component: JSON-RPC 2.0 / Streamable HTTP]&#xa;initialize, tools/list, tools/call, resources and prompts" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="0" y="230" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mcp_identity" value="Trusted Identity Verifier&#xa;[Component: HMAC-SHA256]&#xa;Verifies method/path/user/tenant/space/request binding from Gateway" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mcp_adapter" value="MCP Adapter&#xa;[Component: Reviewed export policy]&#xa;Maps safe Hub capability subset to MCP tools and removes internal arguments" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mcp_hub_client" value="Capability Hub Client&#xa;[Component: private HTTP]&#xa;Only enterprise service client; no database/file/plugin clients" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="610" y="310" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mcp_guard" value="Safety Controls&#xa;[Component: cache + rate limit + timeout]&#xa;Per-user limits, bounded bodies/concurrency, cancellation, idempotency key" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mcp_metrics" value="Audit and Metrics&#xa;[Component: Hub audit + Prometheus]&#xa;No local audit persistence; protocol audit is forwarded to Hub" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="verify each request" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_transport" target="mcp_identity">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="160"/><mxPoint x="120" y="60"/><mxPoint x="120" y="60"/><mxPoint x="120" y="60"/><mxPoint x="290" y="60"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="discover / validate tools" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_transport" target="mcp_adapter">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="260"/><mxPoint x="290" y="260"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="filtered discovery and calls" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_adapter" target="mcp_hub_client">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="220"/><mxPoint x="730" y="220"/><mxPoint x="730" y="220"/><mxPoint x="730" y="220"/><mxPoint x="730" y="300"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="session, timeout, cancel, rate limit" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_transport" target="mcp_guard">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="330"/><mxPoint x="290" y="330"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="method outcome and latency" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_transport" target="mcp_metrics">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="420"/><mxPoint x="120" y="530"/><mxPoint x="120" y="530"/><mxPoint x="120" y="530"/><mxPoint x="290" y="530"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="durable protocol audit" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="mcp_metrics" target="mcp_hub_client">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="530"/><mxPoint x="730" y="530"/><mxPoint x="730" y="530"/><mxPoint x="730" y="530"/><mxPoint x="730" y="440"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
