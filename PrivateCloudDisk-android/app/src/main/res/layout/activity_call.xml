<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_primary">

    <TextView
        android:id="@+id/tv_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:text="正在呼叫..."
        android:textColor="@color/textOnBrand"
        android:textSize="16sp"
        android:alpha="0.8" />

    <TextView
        android:id="@+id/tv_contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_call_status"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:textColor="@color/textOnBrand"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- 头像 -->
    <ImageView
        android:id="@+id/iv_contact_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/tv_contact_name"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_default_avatar" />

    <TextView
        android:id="@+id/tv_call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_contact_avatar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="00:00"
        android:textColor="@color/textOnBrand"
        android:textSize="18sp"
        android:alpha="0.8"
        android:visibility="gone" />

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_mute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_button_primary"
            android:src="@drawable/ic_mute"
            android:padding="14dp"
            android:backgroundTint="#33FFFFFF" />

        <ImageView
            android:id="@+id/btn_speaker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_button_primary"
            android:src="@drawable/ic_speaker"
            android:padding="12dp"
            android:backgroundTint="#33FFFFFF" />

        <ImageView
            android:id="@+id/btn_hangup"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_button_primary"
            android:src="@drawable/ic_call_end"
            android:padding="16dp"
            android:backgroundTint="@color/functionalDanger" />
    </LinearLayout>
</RelativeLayout>