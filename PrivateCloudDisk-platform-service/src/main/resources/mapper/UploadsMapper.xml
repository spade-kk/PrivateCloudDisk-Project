<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.project.mapper.UploadsMapper">
    <resultMap id="UploadsSessionEntityMap" type="org.project.model.entity.UploadsSessionEntity">
        <id column="uploads_id" property="uploads_id" typeHandler="org.project.util.UUIDBinaryTypeHandler"/>
        <result column="uploads_starting_time" property="starting_time"/>
        <result column="uploads_endding_time" property="endding_time"/>
        <result column="uploads_total_chunks" property="total_chunks"/>
        <result column="uploads_chunks_max_size" property="chunks_max_size"/>
        <result column="uploads_file_checksum" property="file_checksum"/>
        <result column="uploads_file_name" property="file_name"/>
        <result column="uploads_file_size" property="file_size"/>
        <result column="uploads_user_id" property="user_id" typeHandler="org.project.util.UUIDBinaryTypeHandler"/>
        <result column="uploads_file_type" property="file_type"/>
        <result column="uploads_node_id" property="node_id" typeHandler="org.project.util.UUIDBinaryTypeHandler"/>
        <result column="uploads_status" property="status"/>
    </resultMap>

    <select id="findUploadsSessionById"  resultMap="UploadsSessionEntityMap">
        select * from pcd_uploads_session_table where uploads_id=#{uploads_id,typeHandler=org.project.util.UUIDBinaryTypeHandler};
    </select>

    <select id="findUserActiveUploadsSession"  resultMap="UploadsSessionEntityMap">
        select * from pcd_uploads_session_table where uploads_user_id=#{user_id,typeHandler=org.project.util.UUIDBinaryTypeHandler} and uploads_status not in ('canceled', 'completed', 'deleted');
    </select>

    <insert id="insertUploadsSession" useGeneratedKeys="true" keyProperty="uploads_id" parameterType="org.project.model.entity.UploadsSessionEntity">
        insert into pcd_uploads_session_table (uploads_id, uploads_user_id, uploads_total_chunks, uploads_starting_time, uploads_endding_time, uploads_file_size, uploads_file_checksum, uploads_chunks_max_size, uploads_file_name, uploads_file_type, uploads_node_id, uploads_status)
        values(#{uploads_id,typeHandler=org.project.util.UUIDBinaryTypeHandler}, #{user_id,typeHandler=org.project.util.UUIDBinaryTypeHandler}, #{total_chunks}, #{starting_time}, #{endding_time}, #{file_size}, #{file_checksum}, #{chunks_max_size}, #{file_name}, #{file_type}, #{node_id,typeHandler=org.project.util.UUIDBinaryTypeHandler}, #{status});
    </insert>

    <update id="updateUploadsSessionStatusById">
        update pcd_uploads_session_table set uploads_status=#{newStatus} where uploads_id=#{uploads_id,typeHandler=org.project.util.UUIDBinaryTypeHandler};
    </update>

    <delete id="deleteUploadsSessionById" parameterType="string">
        delete from pcd_uploads_session_table where uploads_id=#{uploads_id,typeHandler=org.project.util.UUIDBinaryTypeHandler};
    </delete>

    <!-- 查询过期的上传会话（uploading/merging 状态且超过过期时间） -->
    <select id="findExpiredUploadsSessions" resultMap="UploadsSessionEntityMap">
        select * from pcd_uploads_session_table
        where uploads_status in ('uploading', 'merging')
          and uploads_starting_time &lt; #{expireTime};
    </select>

    <!-- 查询已取消（canceled）状态的上传会话 -->
    <select id="findCanceledUploadsSessions" resultMap="UploadsSessionEntityMap">
        select * from pcd_uploads_session_table
        where uploads_status = 'canceled';
    </select>
</mapper>