{
  "name": "私有云盘",
  "appid": "__UNI__PCD001",
  "description": "私有云盘 - 专注多平台小程序的企业级云盘客户端",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "位置信息用于日志记录"
      }
    },
    "lazyCodeLoading": "requiredComponents",
    "optimization": {
      "subPackages": true
    }
  },
  "mp-alipay": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true
    },
    "usingComponents": true
  },
  "mp-baidu": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true
    },
    "usingComponents": true
  },
  "mp-toutiao": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true
    },
    "usingComponents": true
  },
  "h5": {
    "title": "PrivateCloudDisk",
    "router": {
      "mode": "history"
    },
    "devServer": {
      "port": 8080,
      "disableHostCheck": true,
      "proxy": {
        "/api": {
          "target": "http://localhost:8081",
          "changeOrigin": true
        }
      }
    }
  },
  "uniStatistics": {
    "enable": false
  },
  "vueVersion": "3"
}