{
  "name": "privateclouddisk-miniapp",
  "version": "1.0.0",
  "description": "PrivateCloudDisk 多平台小程序客户端 - 支持微信/支付宝/百度/字节小程序",
  "main": "main.js",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:h5": "uni -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:h5": "uni build -p h5",
    "gen:icons": "python3 scripts/gen_tabbar_icons.py"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-components": "3.0.0-alpha-5010320260611001",
