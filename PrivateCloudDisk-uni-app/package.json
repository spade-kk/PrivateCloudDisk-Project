    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5010320260611001",
    "pinia": "^2.1.7",
    "uview-plus": "^3.3.44",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.4",
    "@dcloudio/uni-automator": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5010320260611001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010320260611001",
    "sass": "^1.69.5",
