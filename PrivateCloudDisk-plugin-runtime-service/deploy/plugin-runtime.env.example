# 该文件安装为 /etc/pcd-plugin-runtime/runtime.env，权限必须为 0600。
RUNTIME_ENV=production
RUNTIME_LISTEN_ADDRESS=10.20.0.15:8090
PCD_INTERNAL_SERVICE_TOKEN=ChangeMeToAHighEntropyInternalServiceToken
PLUGIN_SERVICE_URL=https://plugin-service.example.internal
STORAGE_BROKER_URL=https://file-service.example.internal
RUNTIME_WORK_ROOT=/var/lib/pcd-runtime/work
RUNTIME_DOCKER_BINARY=/usr/bin/docker
PLUGIN_SANDBOX_IMAGE=pcd/plugin-sandbox-python:0.1.0
PLUGIN_SANDBOX_RUNTIME=runsc
PLUGIN_SANDBOX_SECCOMP_PROFILE=/etc/pcd-plugin-runtime/seccomp.json
PLUGIN_SANDBOX_APPARMOR_PROFILE=pcd-plugin-sandbox
PLUGIN_RUNTIME_TIMEOUT_SECONDS=120
PLUGIN_VALIDATION_TIMEOUT_SECONDS=5
PLUGIN_SANDBOX_MEMORY_BYTES=536870912
PLUGIN_SANDBOX_CPUS=1.0
PLUGIN_SANDBOX_PIDS_LIMIT=64
PLUGIN_LOG_LIMIT_BYTES=102400
PLUGIN_PACKAGE_MAX_BYTES=10485760
PLUGIN_CANDIDATE_MAX_BYTES=10737418240
