# Cloud AI Agent Service — do not place provider keys in source control.
AI_AGENT_ENVIRONMENT=development
AI_AGENT_PORT=8001
AI_AGENT_REDIS_URL=redis://redis:6379/5
AI_AGENT_CAPABILITY_HUB_URL=http://workflow-service-backend:8087
AI_AGENT_INTERNAL_SERVICE_TOKEN=replace-with-pcd-internal-service-token
# Must match Gateway gateway.ai.identity-signing-secret in non-development deployments.
AI_AGENT_IDENTITY_SHARED_SECRET=replace-with-long-random-secret
AI_AGENT_ALLOW_UNSIGNED_IDENTITY=false
AI_AGENT_LLM_BASE_URL=https://api.openai.com/v1
AI_AGENT_LLM_API_KEY=replace-with-provider-secret
AI_AGENT_LLM_MODEL=gpt-4.1-mini
AI_AGENT_LLM_FALLBACK_MODELS=
AI_AGENT_ALLOWED_ORIGINS=http://localhost:5173
AI_AGENT_MAX_AGENT_ITERATIONS=8
AI_AGENT_MAX_RUN_SECONDS=120
AI_AGENT_MAX_TOOL_CONCURRENCY=4
AI_AGENT_MAX_PROVIDER_CONCURRENCY=32
AI_AGENT_RUN_RATE_LIMIT_PER_MINUTE=20
AI_AGENT_SSE_HEARTBEAT_SECONDS=15
AI_AGENT_ENABLE_WORKFLOW_TOOLS=true
AI_AGENT_ENABLE_PLUGIN_TOOLS=true
