# ============================================================
# PrivateCloudDisk AI Service - 环境变量
# 复制为 .env 并修改
# ============================================================

# --- 服务 ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_NAME=PrivateCloudDisk AI Service

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# --- Redis ---
REDIS_URL=redis://localhost:6379/1

# --- MySQL (与 platform-service 共用) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=20070315mwz
MYSQL_DATABASE=private_cloud_disk

# --- MinIO (对象存储) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=private-cloud-disk
MINIO_SECURE=false

# --- OpenSearch ---
OPENSEARCH_HOST=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=MySecureP@ssw0rd
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false

# --- 模型目录 ---
MODEL_DIR=./models
MODEL_CACHE_DIR=./models/.cache

# --- AI 功能开关 ---
AI_IMAGE_CLASSIFICATION_ENABLED=true
AI_FACE_DETECTION_ENABLED=true
AI_OBJECT_DETECTION_ENABLED=true
AI_NSFW_DETECTION_ENABLED=true
AI_NLP_TAGGING_ENABLED=true
AI_OCR_ENABLED=true
AI_SUMMARIZATION_ENABLED=true
AI_RECOMMENDATION_ENABLED=true

# --- 推理配置 ---
AI_INFERENCE_DEVICE=cpu        # cpu | cuda | mps
AI_INFERENCE_BATCH_SIZE=4
AI_INFERENCE_TIMEOUT_SECONDS=120
AI_MAX_FILE_SIZE_MB=500

# --- Worker 配置 ---
WORKER_PREFETCH_AI=4
WORKER_CONCURRENCY_AI=8
WORKER_PREFETCH_FACE_CLUSTER=1
WORKER_CONCURRENCY_FACE_CLUSTER=2
WORKER_PREFETCH_RECOMMENDATION=1
WORKER_CONCURRENCY_RECOMMENDATION=2
WORKER_PREFETCH_DLQ=1
WORKER_CONCURRENCY_DLQ=2
WORKER_LOG_LEVEL=INFO

# --- 重试策略 ---
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300

# --- 人脸聚类 ---
FACE_CLUSTER_MIN_FACES=10
FACE_CLUSTER_EPS=0.5
FACE_CLUSTER_MIN_SAMPLES=2
FACE_CLUSTER_BATCH_SIZE=100

# --- 推荐系统 ---
RECOMMENDATION_UPDATE_INTERVAL_HOURS=6
RECOMMENDATION_TOP_K=20