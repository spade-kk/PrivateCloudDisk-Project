# 依赖目录（本地安装的包，与容器内 Linux 环境不兼容）
node_modules
#package-lock.json   # 可选：建议保留，但锁文件应复制进镜像；如果不想覆盖可忽略
yarn.lock

# 构建产物（镜像构建时会重新生成）
dist
build
out
.cache
.parcel-cache

# 本地开发配置和环境变量；生产构建需要保留 .env.production
.env.development
.vscode
.idea
*.swp
*.swo
.DS_Store

# 版本控制
.git
.gitignore
.gitattributes

# 日志和临时文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.tmp
*.bak

# 测试和文档
coverage
.nyc_output
tests/
__tests__/
jest.config.js
*.test.js
*.spec.js
README.md
docs/

# Docker 相关文件
Dockerfile
.dockerignore
docker-compose*.yml

# 其他工具配置文件（不影响运行）
.prettierrc*
.eslintrc*
.babelrc*
.editorconfig
.husky
lint-staged.config.js
