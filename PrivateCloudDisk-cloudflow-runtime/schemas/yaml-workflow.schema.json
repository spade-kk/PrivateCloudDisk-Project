{
  "$id": "https://cloudflow.local/schemas/yaml-workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "CloudFlow Workflow 的 YAML 前端（workflow.yaml / flow.yaml）。解析由 serde_yaml_ng 承担，本 Schema 仅供 IDE 校验与补全（需求 31.10-31.11）。",
  "properties": {
    "catch": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "env": {
      "type": "object"
    },
    "finally": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "input": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "outputs": {
      "type": "object"
    },
    "policies": {
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "max_parallel": {
          "type": "number"
        },
        "retry": {},
        "timeout": {}
      },
      "type": "object"
    },
    "steps": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "trigger": {
      "oneOf": [
        {
          "enum": [
            "manual"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cron": {},
            "event": {},
            "every": {
              "type": "string"
            },
            "expression": {
              "type": "string"
            },
            "http": {},
            "interval": {},
            "method": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "schedule": {},
            "timezone": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "type": {
              "enum": [
                "manual",
                "event",
                "cron",
                "schedule",
                "http",
                "webhook",
                "interval"
              ]
            },
            "webhook": {}
          },
          "type": "object"
        }
      ]
    },
    "variables": {
      "type": "object"
    },
    "version": {},
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {}
      },
      "type": "object"
    }
  },
  "required": [
    "steps"
  ],
  "title": "CloudFlow YAML Workflow (yaml.cloudflow.io/v1)",
  "type": "object"
}
