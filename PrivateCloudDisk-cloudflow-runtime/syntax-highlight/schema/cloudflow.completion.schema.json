{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cloudflow.completion.schema.json",
  "title": "CloudFlow DSL Completion Specification",
  "description": "统一代码补全规范（唯一事实来源，由 GRAMMAR.pest + AST.rs 自动生成）。作为 VS Code / Monaco Editor 补全功能的唯一数据源。",
  "type": "object",
  "required": ["$meta", "keywords", "structureTemplates", "builtinFunctions", "types", "triggers", "retryExceptions", "blocks", "pairs", "items", "errorCodes", "snippets", "referencePrefixes"],
  "properties": {
    "$meta": { "type": "object", "required": ["languageId", "version", "generatedFrom", "generatedAt"] },
    "keywords": { "type": "array", "items": { "type": "object", "required": ["id", "label", "kind", "category"] } },
    "structureTemplates": { "type": "array", "items": { "type": "object", "required": ["id", "label", "kind", "insertText", "documentation"] } },
    "builtinFunctions": { "type": "array", "items": { "type": "object", "required": ["name", "signature", "returnType"] } },
    "types": { "type": "array", "items": { "type": "string" } },
    "triggers": { "type": "object" },
    "retryExceptions": { "type": "array", "items": { "type": "string" } },
    "blocks": { "type": "array", "items": { "type": "object", "required": ["id", "label", "kind", "insertText", "documentation"] } },
    "pairs": { "type": "object" },
    "items": { "type": "array", "items": { "type": "object", "required": ["id", "label", "kind", "category", "insertText"] } },
    "errorCodes": { "type": "object", "additionalProperties": { "type": "string" } },
    "snippets": { "type": "object", "additionalProperties": { "type": "object", "required": ["prefix", "template", "doc"] } },
    "referencePrefixes": { "type": "object" },
    "pipelineOperators": { "type": "array" }
  },
  "additionalProperties": true
}
