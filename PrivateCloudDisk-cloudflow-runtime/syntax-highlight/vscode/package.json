{
  "name": "cloudflow-language",
  "displayName": "CloudFlow DSL Language",
  "description": "CloudFlow DSL 静态高亮与基础补全，并通过 CloudFlow Language Server 提供动态语义能力。",
  "version": "1.3.1",
  "publisher": "privateclouddisk",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["cloudflow", "workflow", "dsl"],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:cloudflow",
    "onCommand:cloudflow.login",
    "onCommand:cloudflow.logout",
    "onCommand:cloudflow.clearCapabilityCache",
    "onCommand:cloudflow.restartLanguageServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cloudflow",
        "aliases": ["CloudFlow", "cloudflow"],
        "extensions": [".flow", ".cloudflow"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cloudflow",
        "scopeName": "source.cloudflow",
        "path": "./syntaxes/cloudflow.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cloudflow",
        "path": "./snippets/cloudflow.code-snippets"
      }
    ],
    "commands": [
      { "command": "cloudflow.login", "title": "CloudFlow: 登录平台" },
      { "command": "cloudflow.logout", "title": "CloudFlow: 登出平台" },
      { "command": "cloudflow.showCapabilities", "title": "CloudFlow: 查看语言服务状态" },
      { "command": "cloudflow.clearCapabilityCache", "title": "CloudFlow: 清理能力缓存" },
      { "command": "cloudflow.restartLanguageServer", "title": "CloudFlow: 重启语言服务" }
    ],
    "configuration": {
      "title": "CloudFlow",
      "properties": {
        "cloudflow.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 cloudflow-ls；关闭后保留 syntax-highlight 的静态规则和基础补全。"
        },
        "cloudflow.lsp.serverPath": {
          "type": "string",
          "default": "bundled",
          "description": "cloudflow-ls 可执行文件路径；默认使用扩展内置的当前平台二进制，也可填写绝对路径或 PATH 中的命令名。填写 bundled 使用内置版本。"
        },
        "cloudflow.lsp.tokenFile": {
          "type": "string",
          "default": "",
          "description": "可选的 0600 CloudFlow Token 文件路径；VS Code Secret Storage 中的登录 Token 优先。"
        },
        "cloudflow.lsp.tenantId": {
          "type": "string",
          "default": "",
          "description": "可选租户上下文，仅用于 Capability Hub 的权限过滤。"
        },
        "cloudflow.lsp.spaceId": {
          "type": "string",
          "default": "",
          "description": "可选空间上下文，仅用于 Capability Hub 的权限过滤。"
        },
        "cloudflow.auth.loginUrl": {
          "type": "string",
          "default": "",
          "description": "CloudFlow OAuth2 授权页；登录命令会打开该页面，然后将短期 Access Token 保存到 VS Code Secret Storage。"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "prepare:extension": "node ./scripts/prepare-extension.mjs",
    "test:extension": "node --test tests/extension-contract.test.mjs",
    "vsce:package": "npm run prepare:extension && vsce package"
  }
}
