# 覆盖目标：最小合法 workflow、metadata、manual trigger、普通 action。
# 预期：编译为一个 task 节点，IR apiVersion 为 workflow.cloudflow.io/v1。
workflow "basic_workflow" {
    metadata { display_name = "最小工作流" version = "1.1" }
    trigger { manual {} }
    step list_files { action builtin.file.list { node = "<node-id>" } output files }
}
