# 覆盖目标：[V1.2-INTERPOLATION] 字符串模板 "${...}" 变量嵌入。
# 预期：IR 值生成 {"$template": ["前缀", {"$ref": "vars.name"}, "后缀"]}。
workflow "template" {
    variables {
        name: string = "world"
        greeting = "hello ${vars.name}, welcome"
    }
    step greet { action builtin.file.list {} output result }
}
