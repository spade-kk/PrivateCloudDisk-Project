{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.privateclouddisk.local/plugin/manifest-v1.schema.json",
  "title": "PrivateCloudDisk Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "version", "type", "runtime", "entrypoints"],
  "properties": {
    "schema_version": { "const": 1 },
    "plugin_id": { "type": "string", "format": "uuid" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "type": { "enum": ["CLOUD_PLUGIN", "LOCAL_PLUGIN", "WORKFLOW_PLUGIN"] },
    "runtime": { "enum": ["PYTHON_3_11", "JAVASCRIPT_ES2022", "WORKFLOW_DSL_V1"] },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "module", "function", "permissions"],
        "properties": {
          "event": { "enum": ["pcd.file.content.ready.v1", "pcd.file.available.v1"] },
          "module": { "type": "string", "pattern": "^[A-Za-z0-9_./-]{1,255}$" },
          "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
          "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": { "type": "string", "maxLength": 128 }
          },
          "conditions": { "type": "object" }
        }
      }
    },
    "capabilities": { "type": "array", "maxItems": 32 }
  }
}
