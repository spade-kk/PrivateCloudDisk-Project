<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.project.billing.mapper.BillingEventMapper">

    <insert id="insert" parameterType="org.project.billing.model.entity.BillingEventEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pcd_billing_event_table (user_id, event_type, event_data, operator)
        VALUES (#{userId}, #{eventType}, #{eventData}, #{operator})
    </insert>

</mapper>