# ============================================================
# PrivateCloudDisk - 环境变量配置
# 复制此文件为 .env 并修改相关配置
# cp .env.example .env
# ============================================================

# ==================== 域名 ====================
# 用于 SSL 证书申请和前端配置
DOMAIN=your-domain.com
WWW_DOMAIN=www.your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# ==================== 数据库 ====================
MYSQL_ROOT_PASSWORD=ChangeMe123!
MYSQL_DATABASE=private_cloud_disk
# 生产环境建议使用外部数据库
# MYSQL_EXTERNAL_URL=jdbc:mysql://rds-instance.xxx.rds.aliyuncs.com:3306/private_cloud_disk

# ==================== Redis ====================
# 生产环境强烈建议设置密码
REDIS_PASSWORD=ChangeMe123!

# ==================== RabbitMQ ====================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=ChangeMe123!

# ==================== MinIO 对象存储 ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMe123!
# 使用外部 S3 兼容存储
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# ==================== OpenSearch ====================
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe123!
# OpenSearch 内存 (生产环境根据服务器配置调整)
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ==================== 业务服务 ====================
# Spring 运行环境: docker | dev | prod
SPRING_PROFILES_ACTIVE=docker

# 文件服务 API 文档开关 (生产环境设为 false)
ENABLE_DOCS=false

# 原始内容 Preview Token（Markdown/图片/代码），默认值已按短期授权收紧
PREVIEW_GRANT_TTL_SECONDS=120
PREVIEW_GRANT_USER_MAX_ACTIVE=6
PREVIEW_GRANT_USER_IP_MAX_ACTIVE=3
PREVIEW_GRANT_MAX_REQUESTS=24
PREVIEW_GRANT_RATE_PER_SEC=6
PREVIEW_GRANT_MAX_CONCURRENT=2
PREVIEW_TEXT_MAX_BYTES=10485760
PREVIEW_IMAGE_MAX_BYTES=26214400
PREVIEW_MAX_RANGE_BYTES=8388608

# JWT 密钥 (base64 编码)
# 生成: openssl rand -base64 64
JWT_SECRET=ChangeMeToARandomBase64String

# Turnstile 人机验证 (可选)
SECURITY_CAPTCHA_TURNSTILE_ENABLED=false
SECURITY_CAPTCHA_TURNSTILE_SECRET_KEY=
SECURITY_CAPTCHA_TURNSTILE_EXPECTED_HOSTNAME=

# ==================== 前端 ====================
VITE_API_BASE_URL=/api/v1
VITE_TURNSTILE_SITE_KEY=
VITE_CHUNK_SIZE=5242880
VITE_MAX_CONCURRENT_UPLOADS=3
VITE_MAX_CONCURRENT_DOWNLOADS=4
VITE_UPLOAD_THRESHOLD=10485760
# 文件网格/列表悬停预览延迟，允许范围 800-3000ms
VITE_FILE_HOVER_PREVIEW_DELAY_MS=1800

# ==================== 日志 ====================
# 日志级别: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ==================== 备份 ====================
# 备份保留天数
BACKUP_RETENTION_DAYS=7
# 备份目录
BACKUP_DIR=/backup/privateclouddisk

# ==================== 客户端下载与上传 ====================

# 下载服务器 SSH 信息（rsync 方式上传，推荐）
# DOWNLOAD_SERVER_HOST=your-server.com
# DOWNLOAD_SERVER_USER=deploy
# DOWNLOAD_SERVER_PATH=/opt/privateclouddisk/downloads
# DOWNLOAD_SERVER_SSH_KEY=~/.ssh/deploy_key
